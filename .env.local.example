# ─────────────────────────────────────────────────────────────────────────
# Frontend — copy to .env.local and fill in from your Supabase project:
#   Dashboard → Project Settings → API
#
# Both values are safe to expose in the frontend bundle. Row level security
# (see supabase/migrations/0001_init.sql) is what protects the data.
# Never put the service_role key here — that one bypasses RLS entirely.
# ─────────────────────────────────────────────────────────────────────────

# The URL is the bare project origin — no /rest/v1 path. supabase-js appends
# the service paths (/rest/v1, /auth/v1, …) itself.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# The only account the landing page signs in as. The field on that page is a
# password, not an email — this is what it gets paired with. Ships in the
# browser bundle, so it is not a secret; the password is.
VITE_OWNER_EMAIL=you@example.com

# ─────────────────────────────────────────────────────────────────────────
# Expense sync (the Vercel functions under api/).
#
# None of these are VITE_-prefixed, so Vite never inlines them into the
# browser bundle. Set them in Vercel — `vercel env add <NAME>` — not here,
# unless you're running `vercel dev` locally.
#
# Skip this whole block if you aren't using the bank import; the rest of the
# app runs without it.
# ─────────────────────────────────────────────────────────────────────────

# Same project as above, but the server-side pair. The service_role key
# bypasses RLS, which is what lets an unattended job write rows with no
# logged-in session. Treat it like a root password.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The account the importer writes to. Every table is keyed on user_id and the
# cron job has no session to infer it from, so it has to be told.
# Supabase → Authentication → Users → your row → User UID.
SLOWSTREAK_USER_ID=

# Enable Banking (https://enablebanking.com) → Control Panel → your app.
# The private key is the .pem downloaded at registration. Paste it as one line
# with literal \n between the lines; env.ts unescapes it.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Must match a redirect URL registered on the app, character for character.
ENABLE_BANKING_REDIRECT_URL=https://slowstreak.com/api/connect/callback

# ASPSP identifiers, only if the defaults in api/_lib/banks.ts don't match
# Enable Banking's catalogue for your banks.
# ASPSP_SEB_NAME=SEB
# ASPSP_SEB_COUNTRY=SE
# ASPSP_NORWEGIAN_NAME=Bank Norwegian
# ASPSP_NORWEGIAN_COUNTRY=SE
# ASPSP_AMEX_NAME=American Express
# ASPSP_AMEX_COUNTRY=SE

# Categorises merchants the keyword table doesn't match. Cached per merchant,
# so this is a handful of calls a week once the cache warms up.
ANTHROPIC_API_KEY=

# Authorises the cron endpoint and signs the consent-flow state. Vercel sets
# this for scheduled runs; generate one with `openssl rand -hex 32`.
CRON_SECRET=

# FX source for non-SEK amounts. Frankfurter (ECB rates, no key) by default.
# FX_BASE_URL=https://api.frankfurter.dev/v1
