# Copy to .env.local and fill in from your Supabase project:
#   Dashboard → Project Settings → API
#
# Both values are safe to expose in the frontend bundle. Row level security
# (see supabase/migrations/0001_init.sql) is what protects the data.
# Never put the service_role key here — that one bypasses RLS entirely.

# The URL is the bare project origin — no /rest/v1 path. supabase-js appends
# the service paths (/rest/v1, /auth/v1, …) itself.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
